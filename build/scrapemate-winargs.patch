@@ -0,0 +1,29 @@
+package jshttp
+
+import (
+	"runtime"
+	"strings"
+)
+
+// platformArgs drops Chromium flags that are Linux-only or unsupported on Windows.
+// --single-process is a debug-only mode; on Windows it closes pages right after they
+// open ("Target page, context or browser has been closed"), which gosom then reports
+// as "unexpected page type". --no-zygote is a Linux process-launch flag, and
+// NetworkServiceInProcess forces the same single-process networking.
+func platformArgs(args []string) []string {
+	if runtime.GOOS != "windows" {
+		return args
+	}
+
+	out := make([]string, 0, len(args))
+
+	for _, a := range args {
+		if a == "--single-process" || a == "--no-zygote" || strings.Contains(a, "NetworkServiceInProcess") {
+			continue
+		}
+
+		out = append(out, a)
+	}
+
+	return out
+}
