diff --git a/adapters/fetchers/jshttp/winargs.go b/adapters/fetchers/jshttp/winargs.go
new file mode 100644
index 0000000..f627fd4
--- /dev/null
+++ b/adapters/fetchers/jshttp/winargs.go
@@ -0,0 +1,40 @@
+package jshttp
+
+import (
+	"os"
+	"runtime"
+	"strings"
+)
+
+// platformArgs drops Chromium flags that are Linux-only or unsupported on Windows.
+// --single-process is a debug-only mode; on Windows it closes pages right after they
+// open ("Target page, context or browser has been closed"), which gosom then reports
+// as "unexpected page type". --no-zygote is a Linux process-launch flag, and
+// NetworkServiceInProcess forces the same single-process networking.
+func platformArgs(args []string) []string {
+	if runtime.GOOS != "windows" {
+		return args
+	}
+
+	out := make([]string, 0, len(args))
+
+	for _, a := range args {
+		if a == "--single-process" || a == "--no-zygote" || strings.Contains(a, "NetworkServiceInProcess") {
+			continue
+		}
+
+		out = append(out, a)
+	}
+
+	return out
+}
+
+// browserChannel is the installed browser to drive instead of the bundled Chromium ("msedge", "chrome"), or "".
+func browserChannel() string {
+	return os.Getenv("WAT_BROWSER_CHANNEL")
+}
+
+// browserExe is a Chromium the app downloaded itself (no Edge/Chrome on the PC), or "".
+func browserExe() string {
+	return os.Getenv("WAT_BROWSER_EXE")
+}
